
@{
    Layout = "_DashboardLayout";
}



<div class="container-fluid px-xl-5">
    <section class="py-5">

        <div class="row py-5 mt-4 align-items-center">
            <div class="col-md-5 pr-lg-5 mb-5 mb-md-0">
                @*<img src="~/img/add_customer.svg" alt="Add User SVG" class="img-fluid" />*@
                <h1>Add New Member</h1>
            </div>

            <div class="col-md-7 col-lg-6 ml-auto">
                <form action="/Admin/AddMembers" method="post">
                    <div class="row">

                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-user text-muted"></i>
                                </span>
                            </div>
                            <input id="memberFirstName" type="text" name="memberFirstName" placeholder="First Name" class="form-control bg-white border-left-0 border-md" required>
                        </div>

                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-envelope text-muted"></i>
                                </span>
                            </div>
                            <input id="memberLastName" type="text" name="memberLastName" placeholder="Last Name" class="form-control bg-white border-left-0 border-md" required>
                        </div>

                
                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-map-marker-alt text-muted"></i>
                                </span>
                            </div>
                            <input id="memberAddress" type="text" name="memberAddress" placeholder="Member Address" class="form-control bg-white border-left-0 border-md" required>
                        </div>


                        <!-- Account Type -->
                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-user-tie text-muted"></i>
                                </span>
                            </div>
                            <select id="category" name="category" class="form-control custom-select bg-white border-left-0 border-md">
                                <option value="">Choose Membership Type</option>
                                <option value="Standard">Standard</option>
                                <option value="Premium">Premium</option>
                            </select>
                        </div>
                        
                        <!-- DOB -->
                        <div class="col-md-12 mb-0">
                            <label for="dateofBirth">Date of Birth<i class="fas fa-ellipsis-h ml-2"></i></label>
                        </div>
                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-calendar text-muted"></i>
                                </span>
                            </div>
                            <input type="date" name="DateofBirth" placeholder="" class="form-control py-4 px-4" id="DateofBirth">
                        </div>

                        <div class="form-group col-lg-12 mx-auto mb-0">
                            <button class="btn btn-primary btn-block py-2">
                                <span class="font-weight-bold">Add Member <i class="fas fa-user ml-2"></i></span>
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

