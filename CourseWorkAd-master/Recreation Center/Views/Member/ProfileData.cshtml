@{
	Layout = "_DashboardLayout";
}

<div class="container py-5">
	<div class="row">
		<div class="col-md-6 mx-auto">
			<div class="text-center">
				<p class="h3">User Selected DVD</p>
				<div class="row my-4">
					<div class="col-md-8 mx-auto">
						<img src="/img/DVDStock.jpg" alt="Out of Stock SVG" class="img-fluid" />
					</div>
				</div>
				<p><code> Search Member Detail.</code></p>
			</div>
		</div>
	</div>


	<div class="col-md-10 mx-auto">
		<form action="/Member/ProfileData" method="get">
			<!-- Author Input -->
			<div class="input-group col-lg-6 mb-4">
				<div class="input-group-prepend">
					<span class="input-group-text bg-white px-4 border-md border-right-0">
						<i class="fa fa-address-book text-muted"></i>
					</span>
				</div>
				<select id="producer" name="MemberNumber" class="form-control custom-select bg-white border-left-0 border-md" required>
					<option value="">Select Member</option>
					@foreach (var author in ViewBag.list)
					{
						<option value="@author.MemberNumber"> @author.MemberLastName</option>
					}
				</select>
			</div>

			<div class="text-center">
				<button class="btn btn-primary">View Details <i class="fas fa-check ml-2"></i></button>
			</div>
		</form>

	</div>
	<hr class="my-5" />

	<div my-4>
		<header class="mb-4">
			<p class="h3 text-center">Existing Members Details <i class="fas fa-chevron-down ml-2"></i></p>
		</header>
		<div class="row my-4">
			<div class="col-lg-11 mx-auto">
				<div class="card rounded shadow border-0">
					<div class="card-body p-5 bg-white rounded">
						<div class="table-responsive">
							<table id="example" style="width:100%" class="table table-striped table-bordered">
								<thead>
									<tr>
										<th scope="col">#</th>
										<th scope="col">Title</th>
										<th scope="col">Copy Number</th>
										<th scope="col">Standard Charge</th>
										<th scope="col">Penalty Charge</th>
										
									</tr>
								</thead>
								<tbody>

									@if (Model != null)
									{
										@foreach (var dvd in Model)
										{


											<tr>
												<th scope="row">@dvd.DVDNumber</th>.
												<td>@dvd.DVDTitle</td>
												@foreach (var dv in ViewBag.copy)
												{
													@if (@dvd.DVDNumber == @dv.DVDNumber)
													{
														<td>@dv.CopyNumber</td>
													}
												}

												<td>@dvd.StandardCharge</td>
												<td>@dvd.PenaltyCharge</td>
												
											</tr>
										}
									}
									else
									{
									<td>no item</td>
									}


								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>




</div>