
@{
    Layout = "_DashboardLayout";
}



<div class="container-fluid px-xl-5">
    <section class="py-5">

        <div class="row py-5 mt-4 align-items-center">
            <div class="col-md-5 pr-lg-5 mb-5 mb-md-0">
                <img src="~/img/add_user.svg" alt="Add User SVG" class="img-fluid" />
                <h1>Add New User</h1>
            </div>

            <!-- Add User Form -->
            <div class="col-md-7 col-lg-6 ml-auto">
                <form action="/Admin/AddUser" method="post">
                    <div class="row">

                        <!-- Name -->
                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-user text-muted"></i>
                                </span>
                            </div>
                            <input id="username" type="text" name="Username" placeholder="User Name" class="form-control bg-white border-left-0 border-md" required>
                        </div>
  
                        <!-- Account Type -->
                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-user-tie text-muted"></i>
                                </span>
                            </div>
                            <select id="types" name="usertype"  class="form-control custom-select bg-white border-left-0 border-md">
                                <option value="">Choose the account type</option>
                                <option value="admin">Admin</option>
                                <option value="user">User</option>
                            </select>
                        </div>

                        <!-- Password -->
                        <div class="input-group col-lg-6 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-lock text-muted"></i>
                                </span>
                            </div>
                            <input id="password" type="password" name="password" placeholder="Password" class="form-control bg-white border-left-0 border-md" required>
                        </div>

                        <!-- Password Confirmation -->
                        <div class="input-group col-lg-6 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-lock text-muted"></i>
                                </span>
                            </div>
                            <input id="passwordConfirmation" type="password" name="passwordConfirmation" placeholder="Confirm Password" class="form-control bg-white border-left-0 border-md" required>
                        </div>

                        <!-- Submit Button -->
                        <div class="form-group col-lg-12 mx-auto mb-0">
                            <button class="btn btn-primary btn-block py-2" >
                                <span class="font-weight-bold">Add New User <i class="fas fa-user-plus ml-2"></i></span>
                            </button>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </section>
</div>

