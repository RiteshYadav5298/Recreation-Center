@{
	Layout = "_DashboardLayout";
}

<div class="container py-5">
	<div class="row">
		<div class="col-md-6 mx-auto">
			<div class="text-center">
				<p class="h3">Inactive Customers <i class="fas fa-users ml-2"></i></p>
				<div class="row my-4">
					<div class="col-md-8 mx-auto">
						<img src="/img/CustDVD.jpg" alt="Users SVG" class="img-fluid" />
					</div>
				</div>
				<p><code>The following Member have not rented anything since last 31 days.</code></p>
			</div>
		</div>
	</div>

	<div my-4>
		<div class="row py-5">
			<div class="col-lg-11 mx-auto">
				<div class="card rounded shadow border-0">
					<div class="card-body p-5 bg-white rounded">
						<div class="table-responsive">
							<table id="example" style="width:100%" class="table table-striped table-bordered">
								<thead>
									<tr>
										<th>First Name</th>
										<th>Last Name</th>
										<th>Address</th>
										<th>Date Out</th>
										<th>DVD last date</th>
										<th>DVD Title</th>


									</tr>
								</thead>
								<tbody>
									@if (Model != null)
									{
										@foreach (var item in Model)
										{
											<tr>
												<td>@item.MemberFirstName</td>
												<td>@item.MemberLastName</td>
												<td>@item.MemberAddress</td>
												@foreach (var items in ViewBag.loans)
												{
													@if (@items.MemberNumber == @item.MemberNumber)
													{
														<td>@items.DateOut</td>
														<td>@DateOnly.FromDateTime(DateTime.Now) - @items.DateOut</td>
														break;
													}
												}
												@foreach (var ite in ViewBag.loans)
												{
													@foreach (var it in ViewBag.copy)
													{
														@foreach (var i in ViewBag.title)
														{
															@if (@ite.CopyNumber == @it.CopyNumber && @i.DVDNumber == @it.DVDNumber)
															{
																<td>@i.DVDTitle</td>
																break;
															}
															break;
														}
														break;
													}
													break;
												}


											</tr>
										}
									}
									else
									{
									<td>No item</td>
									}

								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>

	</div>
</div>
