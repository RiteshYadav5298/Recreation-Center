@{
	Layout = "_DashboardLayout";
}

<div class="container py-5">
	<div class="row">
		<div class="col-md-6 mx-auto">
			<div class="text-center">
				<p class="h3">User Searched DVD</p>
				<div class="row my-4">
					<div class="col-md-8 mx-auto">
						
					</div>
				</div>
				<p><code> Search DVD Details.</code></p>
			</div>
		</div>
	</div>


	<div class="col-md-10 mx-auto">
		<form action="/DVD/DVDSearch" method="get">
			<!-- Author Input -->
			<div class="input-group col-lg-12 mb-4">
				<div class="input-group-prepend">
					<span class="input-group-text bg-white px-4 border-md border-right-0">
						<i class="fa fa-address-book text-muted"></i>
					</span>
				</div>
				<select id="producer" name="ActorNumber" class="form-control custom-select bg-white border-left-0 border-md" required>
					<option value="">Select an DVD Title</option>
					@foreach (var author in ViewBag.actorlist)
					{
						<option value="@author.ActorNumber"> @author.ActorSurname</option>
					}
				</select>
			</div>

			<div class="text-center">
				<button class="btn btn-primary">View Data <i class="fas fa-check ml-2"></i></button>
			</div>
		</form>

	</div>
	<hr class="my-5" />
	
		<div my-4>
			<header class="mb-4">
				<p class="h3 text-center">Existing Actors DVD <i class="fas fa-chevron-down ml-2"></i></p>
			</header>
			<div class="row my-4">
				<div class="col-lg-11 mx-auto">
					<div class="card rounded shadow border-0">
						<div class="card-body p-5 bg-white rounded">
							<div class="table-responsive">
								<table id="example" style="width:100%" class="table table-striped table-bordered">
									<thead>
										<tr>
											<th scope="col">#</th>
											<th scope="col">Title</th>
											<th scope="col">Date release</th>
											<th scope="col">Standard Charge</th>
											<th scope="col">Penalty Charge</th>
											<th scope="col">Action</th>
										</tr>
									</thead>
									<tbody>
										
									@if (Model != null)
									{
										@foreach (var dvd in Model)
										{


											<tr>
												<th scope="row">@dvd.DVDNumber</th>.
												<td>@dvd.DVDtitle</td>
												<td>@dvd.DateReleased</td>
												<td>@dvd.StandardCharge</td>
												<td>@dvd.PenaltyCharge</td>
												<td>
													<ul class="list-inline m-0">
														<li class="list-inline-item">
															<a href="@Url.Action("DeleteTitle","DVD",new { dvd.DVDNumber} )" class="btn btn-danger btn-sm rounded-0" type="button" data-toggle="tooltip" data-placement="top" title="Delete"><i class="fa fa-trash"></i></a>
														</li>
													</ul>
												</td>
											</tr>
										}
									}
									else
									{
										<td>no item</td>
									}
									

									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

	


</div>