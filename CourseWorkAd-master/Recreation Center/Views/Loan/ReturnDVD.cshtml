
@{
    Layout = "_DashboardLayout";
}

<div class="container-fluid px-xl-5">
    <section class="py-5">

        <div class="row py-5 mt-4 align-items-center">
            <div class="col-md-5 pr-lg-5 mb-5 mb-md-0">
                @*<img src="~/img/insert_sale.svg" alt="Insert Sale SVG" class="img-fluid" />*@
                <h1>Return Loan</h1>
            </div>

            <!-- Registeration Form -->
            <div class="col-md-7 col-lg-6 ml-auto">
                <form action="/Loan/ReturnDVD" method="post" >
                    <div class="row">

                        <!-- Customer -->
                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-book text-muted"></i>
                                </span>
                            </div>
                            <select id="member" name="member" class="form-control custom-select bg-white border-left-0 border-md">
                                <option value="">Please choose a member</option>
                                @foreach (var mem in ViewBag.memberList)
                                { 
                                    <option value="@mem.MemberNumber">@mem.MemberFirstName @mem.MemberLastName</option>
                                }
                            </select>
                        </div>
                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-lock text-muted"></i>
                                </span>
                            </div>
                            <input id="copy" type="number" name="copy" placeholder="Enter DVD Copy Number" class="form-control bg-white border-left-0 border-md" required>
                        </div>

                        <!-- Submit Button -->
                        <div class="form-group col-lg-12 mx-auto mb-0">
                            <button class="btn btn-primary btn-block py-2">
                                <span class="font-weight-bold">Check out <i class="fas fa-cart-plus ml-2"></i></span>
                            </button>
                        </div>

                    </div>
                </form>
            </div>
                <div my-4>
        <div class="row my-4">
            <div class="col-lg-11 mx-auto">
                <div class="card border-0 shadow">
                    <div class="card-body p-5">

                        <!-- Responsive table -->
                        <div class="table-responsive">
                            <table class="table m-0">
                                <thead>
                                    <tr>
                                        @*<th scope="col">#</th>
                                        <th scope="col">Loan type</th>
                                        <th scope="col">Copy Number</th>
                                        <th scope="col">Date Out</th>
                                        <th scope="col">Date Due</th>*@
                                        <th scope="col">Total Paid</th>
                                        
                                        <th scope="col">Penalty Charge</th>
                                        <th scope="col"> Action </th>
                                        
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.total != null)
                                    {
                                       
                                        <tr>
                                           
                                            <td>@ViewBag.total</td>
                                            
                                            <td>@ViewBag.Penalty</td>
                                            <td>
                                                 <li class="list-inline-item">
                                                        <a href="@Url.Action("ReturnDVD","Loan")" class="btn btn-danger btn-sm rounded-0" type="button" data-toggle="tooltip" data-placement="top" title="Check Out"><i class="fa fa-trash"></i></a>
                                                    </li>
                                            </td>
                                            
                                        </tr>
                                   
                                    }
                                    else
                                    {
                                        <td>No item</td>
                                    }

                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        </div>
    </section>
</div>