	<div my-4>
		<header class="mb-4">
			<p class="h3 text-center"> DVD Loan History Data <i class="fas fa-chevron-down ml-2"></i></p>
		</header>
		<div class="row my-4">
			<div class="col-lg-11 mx-auto">
				<div class="card rounded shadow border-0">
					<div class="card-body p-5 bg-white rounded">
						<div class="table-responsive">
							<table id="example" style="width:100%" class="table table-striped table-bordered">
								<thead>
									<tr>
										
										<th scope="col">Member</th>
										<th scope="col">Total Loan</th>
										
									</tr>
								</thead>
								<tbody>
									@if (Model != null)
									{

										@foreach (var it in Model)
										{
											<tr>
												@foreach (var items in (List<LoanCountViewModel>)ViewBag.d)
												{	
													@foreach (var i in ViewBag.de)
										{
														if (@items.Name == @it.MemberNumber && @i.MembershipCategoryTotalLoans <= @items.Count)
														{
															<td>@it.MemberFirstName</td>
															<td>@items.Count</td>
															break;
														}
														break;
													}
												}
											</tr>
										}

									}
									else
									{
									<td>no item</td>
									}


								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>


</div>