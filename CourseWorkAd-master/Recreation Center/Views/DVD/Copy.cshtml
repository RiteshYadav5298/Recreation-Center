@{ Layout = "_DashboardLayout"; }
@if (ViewBag.issuccess)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>New DVD Copy added successfully!</strong>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
else if (ViewBag.isdeletecop)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>DVD Copy Deleted!</strong>
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
<div class="container">
    <header class="text-center">
        <h1 class="display-4 font-weight-bold">Add New DVD Copy</h1>
    </header>
</div>


<div class="container py-5">
    <div class="row">
        <div class="col-md-6 mx-auto">
            <div class="text-center">
                <div class="row mb-4">
                    <div class="col-md-6 mx-auto">
                        @*<img src="/img/author.svg" alt="Author SVG" class="img-fluid" />*@
                    </div>
                </div>
            </div>

            <form action="/DVD/AddCopy" method="post">
                <!-- Author Input -->
                <div class="input-group col-lg-6 mb-4">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white px-4 border-md border-right-0">
                                <i class="fa fa-address-book text-muted"></i>
                            </span>
                        </div>
                        <select id="producer" name="num" class="form-control custom-select bg-white border-left-0 border-md" required>
                            <option value="">Select an DVD Title</option>
                            @foreach (var author in ViewBag.DVDnumber)
                            {
                <option value="@author.DVDNumber"> @author.DVDtitle</option>}
                        </select>
                    </div>
                <div class="col-md-12 mb-0">
                            <label for="dateofBirth">Purchased Date<i class="fas fa-ellipsis-h ml-2"></i></label>
                        </div>
                        <div class="input-group col-lg-12 mb-4">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-white px-4 border-md border-right-0">
                                    <i class="fa fa-calendar text-muted"></i>
                                </span>
                            </div>
                            <input type="date" name="dates" placeholder="" class="form-control py-4 px-4" id="DateofBirth">
                        </div>
                       

                <div class="text-center">
                    <button class="btn btn-primary">Add DVD Copy <i class="fas fa-check ml-2"></i></button>
                </div>
            </form>

        </div>
    </div>

    <hr class="my-5" />

    <div my-4>
        <header class="mb-4">
            <p class="h3 text-center">Existing Authors <i class="fas fa-chevron-down ml-2"></i></p>
        </header>
        <div class="row my-4">
            <div class="col-lg-7 mx-auto">
                <div class="card border-0 shadow">
                    <div class="card-body p-5">

                        <!-- Responsive table -->
                        <div class="table-responsive">
                            <table class="table m-0">
                                <thead>
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">DVD Title</th>
                                        <th scope="col">Date Purchased</th>
                                        <th scope="col">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.CopyNumber</td>
                                            <td>@item.DVDNumber</td>
                                            <td>@item.DatePurchase</td>
                                            <td>
                                                <ul class="list-inline m-0">
                                                    <li class="list-inline-item">
                                                        <a href="@Url.Action("DeleteCopy","DVD",new { item.CopyNumber} )" class="btn btn-danger btn-sm rounded-0" type="button" data-toggle="tooltip" data-placement="top" title="Delete"><i class="fa fa-trash"></i></a>
                                                    </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>